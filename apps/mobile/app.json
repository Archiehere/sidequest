{
  "expo": {
    "name": "SideQuest",
    "slug": "sidequest",
    "scheme": "sidequest",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0B0B0F"
    },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.sidequest.app" },
    "android": { "package": "com.sidequest.app" },
    "plugins": ["expo-router"],
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
